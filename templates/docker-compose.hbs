services:
{{#each services}}
  {{{yq name}}}:
    image: {{{yq imageRef}}}
    {{#if ports}}
    ports:
      {{#each ports}}
      - {{{yq this}}}
      {{/each}}
    {{/if}}
    {{#if envLines}}
    environment:
      {{#each envLines}}
      - {{{this}}}
      {{/each}}
    {{/if}}
    {{#if volumes}}
    volumes:
      {{#each volumes}}
      - {{this}}
      {{/each}}
    {{/if}}
    {{#if healthcheck}}
    healthcheck:
{{{healthcheck}}}
    {{/if}}
    networks:
      - {{{yq ../networkName}}}
{{/each}}

{{#if volumeNames}}
volumes:
{{#each volumeNames}}
  {{this}}:
{{/each}}

{{/if}}
networks:
  {{{yq networkName}}}:
    name: {{{yq networkName}}}
