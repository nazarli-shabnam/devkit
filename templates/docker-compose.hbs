version: "3.8"

services:
{{#each services}}
  {{{yq name}}}:
    image: {{{yq imageRef}}}
    {{#if ports}}
    ports:
      {{#each ports}}
      - {{{yq this}}}
      {{/each}}
    {{/if}}
    {{#if envLines}}
    environment:
      {{#each envLines}}
      - {{{this}}}
      {{/each}}
    {{/if}}
    {{#if healthcheck}}
    healthcheck:
{{{healthcheck}}}
    {{/if}}
    networks:
      - {{{yq ../networkName}}}
{{/each}}

networks:
  {{{yq networkName}}}:
    name: {{{yq networkName}}}
